input {
    workspace-auto-back-and-forth
}

layout {
    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    tab-indicator {
        position "top"
        place-within-column
        hide-when-single-tab
    }

    background-color "transparent"
}

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

// The bar's workspace switcher sits in the top-left corner, where the default
// hot corner would toggle the overview.
gestures {
    hot-corners {
        off
    }
}

// Declaring binds here drops niri's defaults, whose Mod+ variants open the
// switcher alongside Mod+Tab toggling the overview.
recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

hotkey-overlay {
    skip-at-startup
}

// Without this, CEF apps such as Spotify draw their own title bar, which before
// CEF 149 is Chromium's old blue frame.
// https://github.com/chromiumembedded/cef/issues/4061
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Discord and Telegram activate their windows from notifications and tray
// icons with tokens that have invalid serials, which niri ignores by default.
debug {
    honor-xdg-activation-with-invalid-serial
}

// DankMaterialShell overrides
include optional=true "dms/alttab.kdl"
include optional=true "dms/binds.kdl"
include optional=true "dms/colors.kdl"
include optional=true "dms/cursor.kdl"
include optional=true "dms/layout.kdl"
include optional=true "dms/outputs.kdl"
include optional=true "dms/wpblur.kdl"
include optional=true "dms/windowrules.kdl"
include optional=true "dms/input.kdl"
